# Environment Configuration Template
# Copy this file to .env and customize as needed

# Model Configuration
MODEL_PATH=runs/detect/train/weights/best.pt

# API Configuration
API_HOST=0.0.0.0
API_PORT=8010

# Detection Parameters
CONFIDENCE_THRESHOLD=0.1
IOU_THRESHOLD=0.45
DETECTION_STRATEGY=best
TOP_N_DETECTIONS=1

# File Upload Limits
MAX_FILE_SIZE_MB=10

# Logging
LOG_LEVEL=INFO
